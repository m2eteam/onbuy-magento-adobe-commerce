<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">

    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <!-- Integration ACL -->
                <resource id="M2E_OnBuy::onbuy" title="OnBuy Integration" sortOrder="61">
                    <!-- Listing -->
                    <resource id="M2E_OnBuy::listings" title="Listings" sortOrder="1">
                        <resource id="M2E_OnBuy::listings_items" title="Items" sortOrder="1"/>
                        <resource id="M2E_OnBuy::listings_logs" title="Logs &#38; Events" sortOrder="2"/>
                    </resource>
                    <!-- Sales -->
                    <resource id="M2E_OnBuy::sales" title="Sales" sortOrder="2">
                        <resource id="M2E_OnBuy::sales_orders" title="Orders" sortOrder="1"/>
                        <resource id="M2E_OnBuy::sales_logs" title="Logs &#38; Events" sortOrder="2"/>
                    </resource>
                    <!-- Configuration -->
                    <resource id="M2E_OnBuy::configuration" title="Configuration" sortOrder="3">
                        <resource id="M2E_OnBuy::configuration_accounts" title="Accounts" sortOrder="1"/>
                        <resource id="M2E_OnBuy::configuration_templates" title="Policies" sortOrder="3"/>
                        <resource id="M2E_OnBuy::configuration_settings" title="Settings" sortOrder="4"/>
                    </resource>
                    <!-- Help Center -->
                    <resource id="M2E_OnBuy::help_center" title="Help Center" sortOrder="4">
                        <resource id="M2E_OnBuy::help_center_health_status" title="Health Status" sortOrder="1"/>
                        <resource id="M2E_OnBuy::help_center_synchronization_log" title="Synchronization Logs"
                                  sortOrder="2"/>
                        <resource id="M2E_OnBuy::help_center_m2e_support" title="M2E Support" sortOrder="3"/>
                    </resource>
                </resource>
                <!-- System Configuration ACL -->
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="M2E_OnBuy::system_configuration" title="OnBuy Connect" sortOrder="450" />
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>

</config>
